<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="publisher" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="files/**/PassVault*.exe"
      min-matches="1"
      max-matches="1"
      product-name="PassVault"
      product-version="${version}">
      <authenticode-sign
        hash-algorithm="sha256"
        description="PassVault"
        description-url="https://github.com/Apdelrahman1911/passvault" />
    </pe-file>
    <msi-file
      path="files/**/PassVault-*.msi"
      min-matches="0"
      max-matches="1"
      subject="PassVault"
      author="${publisher}">
      <authenticode-sign
        hash-algorithm="sha256"
        description="PassVault"
        description-url="https://github.com/Apdelrahman1911/passvault" />
    </msi-file>
  </zip-file>
</artifact-configuration>
