<?xml version="1.0" encoding="utf-8"?>
<!--
    Background layer for the PassVault adaptive launcher icon.
    Uses a gradient background matching the app's primary color scheme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillType="evenOdd"
        android:pathData="M0,0 L108,0 L108,108 L0,108 z"
        android:strokeWidth="0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF006C4C"
                    android:offset="0.0" />
                <item
                    android:color="#FF004D35"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
