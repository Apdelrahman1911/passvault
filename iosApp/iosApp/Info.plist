<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>PassVault Encrypted Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.passvault.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pvault</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-passvault-backup</string>
			</dict>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan authenticator QR codes for your saved accounts.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock your PassVault vault.</string>
	<key>UILaunchStoryboardName</key>
	<string>PassVaultLaunchScreen</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The vault, lifecycle bridge, and native picker services are process-wide
	     singletons. Keep one scene so a second iPad window cannot race their
	     lock state or receive a picker requested by another scene. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
