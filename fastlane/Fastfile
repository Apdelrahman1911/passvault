require "base64"

opt_out_usage

def required_env(name)
  value = ENV[name]
  UI.user_error!("#{name} is required") if value.nil? || value.strip.empty?
  value
end

def store_root
  File.expand_path(required_env("STORE_METADATA_ROOT"))
end

def read_store_file(relative_path)
  path = File.expand_path(relative_path, store_root)
  UI.user_error!("Unsafe store metadata path") unless path.start_with?(store_root + File::SEPARATOR)
  UI.user_error!("Missing store metadata file: #{relative_path}") unless File.file?(path)
  File.read(path, encoding: "UTF-8").strip
end

def asc_api_key
  decoded_key = Base64.strict_decode64(required_env("ASC_PRIVATE_KEY_BASE64"))
  app_store_connect_api_key(
    key_id: required_env("ASC_KEY_ID"),
    issuer_id: required_env("ASC_ISSUER_ID"),
    key_content: decoded_key,
    is_key_content_base64: false,
    duration: 1_200,
    in_house: false,
  )
ensure
  decoded_key&.replace("\0" * decoded_key.bytesize)
end

def play_upload(track:, release_status:)
  aab = required_env("ANDROID_AAB_PATH")
  credentials = required_env("GOOGLE_APPLICATION_CREDENTIALS")
  UI.user_error!("Signed Android App Bundle is missing") unless File.file?(aab)
  UI.user_error!("OIDC credentials file is missing") unless File.file?(credentials)
  upload_store_assets = ENV["UPLOAD_STORE_ASSETS"] == "true"

  upload_to_play_store(
    package_name: required_env("ANDROID_PACKAGE_NAME"),
    aab: aab,
    track: track,
    release_status: release_status,
    metadata_path: File.join(store_root, "android"),
    json_key: credentials,
    mapping: ENV["ANDROID_MAPPING_PATH"],
    skip_upload_images: !upload_store_assets,
    skip_upload_screenshots: !upload_store_assets,
    timeout: 600,
  )
end

def play_promote(from:, to:, release_status:)
  credentials = required_env("GOOGLE_APPLICATION_CREDENTIALS")
  UI.user_error!("OIDC credentials file is missing") unless File.file?(credentials)

  upload_store_assets = ENV["UPLOAD_STORE_ASSETS"] == "true"
  options = {
    package_name: required_env("ANDROID_PACKAGE_NAME"),
    json_key: credentials,
    track: from,
    track_promote_to: to,
    version_code: required_env("BUILD_NUMBER"),
    release_status: release_status,
    metadata_path: File.join(store_root, "android"),
    skip_upload_apk: true,
    skip_upload_aab: true,
    skip_upload_metadata: !upload_store_assets,
    skip_upload_changelogs: false,
    skip_upload_images: !upload_store_assets,
    skip_upload_screenshots: !upload_store_assets,
    timeout: 600,
  }
  upload_to_play_store(**options)
end

def export_compliance_uses_non_exempt_encryption
  case required_env("EXPORT_COMPLIANCE_STATUS")
  when "EXEMPT_APPROVED"
    UI.user_error!(
      "France must remain excluded while EXEMPT_APPROVED is used",
    ) unless required_env("IOS_FRANCE_AVAILABLE") == "false"
    false
  when "NON_EXEMPT_APPROVED" then true
  else
    UI.user_error!("An approved export-compliance status is required")
  end
end

def beta_review_notes
  <<~NOTES.strip
    PassVault is a local-first password manager. It has no PassVault account, server login, advertising, paid features, purchases, or PassVault-operated cloud synchronization.

    Access instructions: launch the app, choose to create a new vault, and enter any new master password created only for review. No supplied credentials or network account are required.

    Suggested review flow:
    1. Create and unlock a local vault.
    2. Add, edit, move, and delete a test credential and secure note.
    3. Add a TOTP secret to a test credential and observe the rotating one-time code.
    4. If Face ID is enrolled on the device, enable optional biometric unlock in Settings, lock the vault, and unlock it biometrically. The master password remains the vault credential; biometric protection uses the platform facility.
    5. In Settings > Backup, export an encrypted backup using a new review-only backup password. Import that file and password to validate restore.
    6. Delete individual test items in the app. Removing PassVault from the device deletes its local app sandbox and vault.

    Vault records and backup payloads are encrypted by the app on device. PassVault does not require or contact an application server. Please use fictional review data only.
  NOTES
end

def app_review_information
  contact_name = required_env("APP_REVIEW_CONTACT_NAME").split(/\s+/, 2)
  {
    first_name: contact_name.first,
    last_name: contact_name.last || "Release",
    phone_number: required_env("APP_REVIEW_PHONE"),
    email_address: required_env("APP_REVIEW_EMAIL"),
    notes: beta_review_notes,
  }
end

def testflight_upload(external:)
  ipa = required_env("IOS_IPA_PATH")
  UI.user_error!("Signed iOS IPA is missing") unless File.file?(ipa)

  options = {
    api_key: asc_api_key,
    app_identifier: required_env("IOS_BUNDLE_ID"),
    apple_id: required_env("APP_STORE_APP_ID"),
    ipa: ipa,
    distribute_external: external,
    notify_external_testers: external && ENV["TESTFLIGHT_NOTIFY_AFTER_APPROVAL"] == "true",
    submit_beta_review: external,
    skip_waiting_for_build_processing: false,
    app_version: required_env("APP_VERSION"),
    build_number: required_env("BUILD_NUMBER"),
    uses_non_exempt_encryption: export_compliance_uses_non_exempt_encryption,
    beta_app_feedback_email: required_env("SUPPORT_EMAIL"),
    beta_app_description: read_store_file("testflight/en-US/description.txt"),
    changelog: read_store_file("testflight/en-US/what_to_test.txt"),
    localized_app_info: {
      "en-US" => {
        feedback_email: required_env("SUPPORT_EMAIL"),
        marketing_url: required_env("PROJECT_URL"),
        privacy_policy_url: required_env("PRIVACY_POLICY_URL"),
        description: read_store_file("testflight/en-US/description.txt"),
      },
      "ar-SA" => {
        feedback_email: required_env("SUPPORT_EMAIL"),
        marketing_url: required_env("PROJECT_URL"),
        privacy_policy_url: required_env("PRIVACY_POLICY_URL"),
        description: read_store_file("testflight/ar-SA/description.txt"),
      },
    },
    localized_build_info: {
      "en-US" => { whats_new: read_store_file("testflight/en-US/what_to_test.txt") },
      "ar-SA" => { whats_new: read_store_file("testflight/ar-SA/what_to_test.txt") },
    },
  }

  if external
    options[:groups] = [required_env("TESTFLIGHT_EXTERNAL_GROUP")]
    distribution_mode = required_env("TESTFLIGHT_DISTRIBUTION_MODE")
    unless %w[public-link email-list].include?(distribution_mode)
      UI.user_error!("TESTFLIGHT_DISTRIBUTION_MODE must be public-link or email-list")
    end
    if distribution_mode == "email-list"
      tester_file = required_env("TESTFLIGHT_EXTERNAL_TESTERS_FILE")
      UI.user_error!("The external tester CSV is missing") unless File.file?(tester_file)
      options[:testers_file_path] = tester_file
    end
    options[:demo_account_required] = false
    contact_name = required_env("APP_REVIEW_CONTACT_NAME").split(/\s+/, 2)
    options[:beta_app_review_info] = {
      contact_first_name: contact_name.first,
      contact_last_name: contact_name.last || "Release",
      contact_email: required_env("APP_REVIEW_EMAIL"),
      contact_phone: required_env("APP_REVIEW_PHONE"),
      notes: beta_review_notes,
    }
  end

  upload_to_testflight(**options)
end

def distribute_existing_testflight_build
  options = {
    api_key: asc_api_key,
    app_identifier: required_env("IOS_BUNDLE_ID"),
    apple_id: required_env("APP_STORE_APP_ID"),
    app_platform: "ios",
    distribute_only: true,
    distribute_external: true,
    app_version: required_env("APP_VERSION"),
    build_number: required_env("BUILD_NUMBER"),
    groups: [required_env("TESTFLIGHT_EXTERNAL_GROUP")],
    notify_external_testers: ENV["TESTFLIGHT_NOTIFY_AFTER_APPROVAL"] == "true",
    submit_beta_review: true,
    demo_account_required: false,
    skip_waiting_for_build_processing: false,
  }
  if required_env("TESTFLIGHT_DISTRIBUTION_MODE") == "email-list"
    tester_file = required_env("TESTFLIGHT_EXTERNAL_TESTERS_FILE")
    UI.user_error!("The external tester CSV is missing") unless File.file?(tester_file)
    options[:testers_file_path] = tester_file
  end
  upload_to_testflight(**options)
end

platform :android do
  desc "Upload a signed AAB to the Play internal track"
  lane :internal do
    play_upload(track: "internal", release_status: "completed")
  end

  desc "Upload a signed AAB to the Play closed beta track"
  lane :closed do
    play_upload(track: "beta", release_status: "completed")
  end

  desc "Promote the exact internal build to closed testing"
  lane :promote_external do
    play_promote(from: "internal", to: "beta", release_status: "completed")
  end

  desc "Reject Play open testing until a reviewed open-test plan is enabled"
  lane :open do
    UI.user_error!("Play open testing is disabled; configure and approve real testers before enabling it")
  end

  desc "Upload a signed AAB to production after protected confirmation"
  lane :production do
    UI.user_error!("Production approval is missing") unless ENV["PASSVAULT_PRODUCTION_APPROVED"] == "I_APPROVE_PRODUCTION"
    UI.user_error!("Required store testing is not confirmed") unless ENV["PASSVAULT_REQUIRED_TESTING_CONFIRMED"] == "I_CONFIRM_REQUIRED_TESTING_COMPLETED"
    play_upload(track: "production", release_status: "completed")
  end


  desc "Promote the exact tested build from closed testing to full production"
  lane :promote_production do
    UI.user_error!("Production approval is missing") unless ENV["PASSVAULT_PRODUCTION_APPROVED"] == "I_APPROVE_PRODUCTION"
    UI.user_error!("Required store testing is not confirmed") unless ENV["PASSVAULT_REQUIRED_TESTING_CONFIRMED"] == "I_CONFIRM_REQUIRED_TESTING_COMPLETED"
    play_promote(from: "beta", to: "production", release_status: "completed")
  end
end

platform :ios do
  desc "Upload a signed IPA to internal TestFlight"
  lane :internal do
    testflight_upload(external: false)
  end

  desc "Upload and submit a signed IPA to external TestFlight review"
  lane :external do
    testflight_upload(external: true)
  end


  desc "Distribute the exact internal TestFlight build to the external group"
  lane :promote_external do
    distribute_existing_testflight_build
  end

  desc "Upload an App Store review candidate without submitting or releasing it"
  lane :production_candidate do
    UI.user_error!("Production approval is missing") unless ENV["PASSVAULT_PRODUCTION_APPROVED"] == "I_APPROVE_PRODUCTION"
    UI.user_error!("Required store testing is not confirmed") unless ENV["PASSVAULT_REQUIRED_TESTING_CONFIRMED"] == "I_CONFIRM_REQUIRED_TESTING_COMPLETED"
    export_compliance_uses_non_exempt_encryption
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: required_env("IOS_BUNDLE_ID"),
      ipa: required_env("IOS_IPA_PATH"),
      app_version: required_env("APP_VERSION"),
      metadata_path: File.join(store_root, "ios"),
      app_review_information: app_review_information,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      screenshots_path: File.join(store_root, "ios-screenshots"),
      skip_screenshots: false,
      precheck_include_in_app_purchases: false,
    )
  end


  desc "Submit the exact tested TestFlight build and release automatically after Apple approval"
  lane :promote_production do
    UI.user_error!("Production approval is missing") unless ENV["PASSVAULT_PRODUCTION_APPROVED"] == "I_APPROVE_PRODUCTION"
    UI.user_error!("Required store testing is not confirmed") unless ENV["PASSVAULT_REQUIRED_TESTING_CONFIRMED"] == "I_CONFIRM_REQUIRED_TESTING_COMPLETED"
    export_compliance_uses_non_exempt_encryption
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: required_env("IOS_BUNDLE_ID"),
      app_version: required_env("APP_VERSION"),
      build_number: required_env("BUILD_NUMBER"),
      metadata_path: File.join(store_root, "ios"),
      screenshots_path: File.join(store_root, "ios-screenshots"),
      app_review_information: app_review_information,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
