# EditorConfig for PassVault
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,gradle}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{sh,bash}]
indent_size = 2

[*.properties]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.toml]
indent_size = 2

[*.pro]
indent_size = 2

# KDoc/Javadoc comment formatting
[*.kt]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_packages_to_use_import_on_demand = unset

# Compose specific
[*/ui/**/*.{kt,kts}]
max_line_length = 100

# Test files
[*/test/**/*.{kt,kts}]
max_line_length = 140

[*.kts]
ktlint_disabled_rules = import-ordering
