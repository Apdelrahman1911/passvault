+    def observe_job_members(self, deadline, observation):
+        """One bounded, racy snapshot; grants no signaling or cleanup authority.
+
+        Called only inside the original drain interval, never after its deadline
+        or from termination. Results stay in memory until existing finalization;
+        no diagnostic journal I/O is added while descendants are draining.
+        """
+        observation.update(status="PARTIAL", max_members=16, members=[],
+                           sampled_at=time.time(), query_only=True, not_a_census=True)
+
+        def ready():
+            if CANCELLED or time.monotonic() >= deadline:
+                observation["stop_reason"] = "CANCELLED" if CANCELLED else "DEADLINE"
+                return False
+            return True
+
+        if not ready():
+            return
+        listed = JOB_PROCESS_IDS()
+        if not self.k.QueryInformationJobObject(self.job, 3, ctypes.byref(listed),
+                                                 ctypes.sizeof(listed), None):
+            observation.update(status="JOB_LIST_UNKNOWN", winerror=ctypes.get_last_error())
+            return  # Including ERROR_MORE_DATA: no resize, retry or fallback scan.
+        observation.update(reported_assigned=listed.assigned, reported_listed=listed.listed)
+        if not 0 <= listed.listed <= 16 or listed.assigned < listed.listed:
+            observation["status"] = "JOB_LIST_COUNTS_UNKNOWN"
+            return
+        for pid in listed.pids[:listed.listed]:
+            if not ready():
+                return
+            member = {"enumerated_pid": pid, "membership": "UNKNOWN"}
+            observation["members"].append(member)
+            if not 0 < pid <= 0xffffffff:
+                member["status"] = "PID_OUT_OF_RANGE"
+                continue
+            # PROCESS_QUERY_LIMITED_INFORMATION only; non-inheritable. Not even
+            # SYNCHRONIZE, and never PROCESS_TERMINATE/VM_READ or a name scan.
+            handle = self.k.OpenProcess(0x1000, False, pid)
+            if not handle:
+                member.update(status="OPEN_UNKNOWN", winerror=ctypes.get_last_error())
+                continue
+            try:
+                if not ready():
+                    return
+                belongs = wt.BOOL()
+                if not self.k.IsProcessInJob(handle, self.job, ctypes.byref(belongs)):
+                    member.update(status="MEMBERSHIP_UNKNOWN", winerror=ctypes.get_last_error())
+                    continue
+                if not belongs.value:
+                    member["status"] = "NOT_CURRENT_JOB_MEMBER"
+                    continue  # PID reuse: query no image, times, environment or command line.
+                member.update(membership="CONFIRMED_ON_OPEN_HANDLE", verified_at=time.time())
+                if not ready():
+                    return
+                created, exited, kernel, user = (wt.FILETIME() for _ in range(4))
+                if self.k.GetProcessTimes(handle, ctypes.byref(created), ctypes.byref(exited),
+                                           ctypes.byref(kernel), ctypes.byref(user)):
+                    member["creation_filetime_100ns"] = (created.dwHighDateTime << 32) | created.dwLowDateTime
+                else:
+                    member["creation_time_winerror"] = ctypes.get_last_error()
+                if not ready():
+                    return
+                image = ctypes.create_unicode_buffer(512)
+                length = wt.DWORD(len(image))
+                if self.k.QueryFullProcessImageNameW(handle, 0, image, ctypes.byref(length)):
+                    # Only the basename is retained, plus an opaque full-path
+                    # hash. No image file, command line, environment or target is read.
+                    image_path = image[:length.value]
+                    member["image_basename"] = Path(image_path).name
+                    member["image_path_sha256_utf16le"] = hashlib.sha256(
+                        image_path.encode("utf-16le", errors="surrogatepass")).hexdigest()
+                else:
+                    member["image_winerror"] = ctypes.get_last_error()
+                member["status"] = "MEMBER_QUERIED_WITH_POSSIBLE_UNKNOWNS"
+            finally:
+                closed = self.k.CloseHandle(handle)  # Required even at cancellation/deadline.
+                member["query_handle_close_observed"] = bool(closed)
+                if not closed:
+                    member["query_handle_close_winerror"] = ctypes.get_last_error()
+                    # Normal command finally still attempts its original exact-Job
+                    # termination. Do not continue commands with an unclosed handle.
+                    raise RuntimeError("Diagnostic query-only handle close unproved; no retry")
+        observation["status"] = "BOUNDED_RACY_SNAPSHOT_FINISHED"
