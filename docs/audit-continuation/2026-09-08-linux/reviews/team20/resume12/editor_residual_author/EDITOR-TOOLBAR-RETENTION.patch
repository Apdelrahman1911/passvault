+        fun keepEditingAfterToolbarBack(fieldId: String) {
+            val accepted = fields()
+            val pending = onEdt {
+                val state = model.state.value
+                assertFalse(state.isBusy, "ROOM_EDITOR_BACK_WHILE_BUSY")
+                assertFalse(state.showDiscardConfirmation, "ROOM_EDITOR_PRIOR_DISCARD_DIALOG")
+                val draft = assertNotNull(state.customFieldDrafts[CustomFieldId(fieldId)])
+                FieldValue(fieldId, draft.name, draft.value, draft.isSecret)
+            }
+            clickEvent(button("Back"), "OnCancelClick")
+            settle()
+            assertTrue(onEdt { model.state.value.showDiscardConfirmation }, "ROOM_EDITOR_BACK_DID_NOT_WARN")
