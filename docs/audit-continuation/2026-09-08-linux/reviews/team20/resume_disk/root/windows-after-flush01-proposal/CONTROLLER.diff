+def native_case_disposal_admission(run, commands_returned, failures):
+    """Failure keeps all original temp bytes; this never weakens Job/handle settlement."""
+    started = any(value["state"] != "UNSTARTED" for value in run.case_results.values())
+    if not started:
+        return {"allowed": True, "scope": "NO_NATIVE_CASE_LAUNCH_ATTEMPT"}
+    if not commands_returned or failures or any(value.get("ctest_exit_code") != 0
+                                               for value in run.case_results.values()):
+        return {"allowed": False, "scope": "AFTER_FLUSH_CASE_INCOMPLETE_OR_FAILED_HOLD"}
+    witnesses = []
+    for index, case in enumerate(CASES, 1):
+        run.cleanup_time()
+        records = [r for r in run.command_results if r["log"].endswith(f"-case-{index}.log")]
+        require(len(records) == 1 and records[0]["exit_code"] == 0, "Missing exact successful case command")
+        name = records[0]["log"]
+        log = frozen_bytes(run.evidence / name)
+        retention = json.loads(frozen_bytes(run.evidence / (Path(name).stem + "-retention.json")),
+                               object_pairs_hook=no_duplicate_keys)
+        require(retention["complete"] is True and retention["owned_job_settled"] is True
+                and retention["retained_bytes"] == len(log)
+                and retention["retained_sha256"] == hashlib.sha256(log).hexdigest()
+                == retention["settled_full_sha256"], "Native cleanup witness lacks complete settled log")
+        lines = [line for line in log.decode("utf-8").splitlines() if "PVA036_AFTER_FLUSH " in line]
+        selected = CASE_ARGV[case][1]
+        action, residual, code = (("RELEASED", "NONE", 0) if selected == "continue" else
+                                  ("TERMINATED", "OWNED_FLUSHED_STAGING", 0x036af053))
+        number = r"[0-9]{1,10}"
+        pattern = (r"(?:[0-9]+: )?PVA036_AFTER_FLUSH case=" + selected +
+            r" process=[1-9][0-9]{0,9} creation=" + number + ":" + number +
+            " exit=" + str(code) + " stage_id=" + ":".join([number] * 3) +
+            " destination_id=" + ":".join([number] * 3) +
+            " real_flush=PASS held_before_close=PASS action=" + action + " residual=" + residual +
+            " pre_teardown=PASS cleanup=PASS")
+        setup_pattern = (r"(?:[0-9]+: )?PVA036_AFTER_FLUSH case=" + selected +
+            r" fixture=passvault-after-flush-[0-9a-f]{16} root_id=" + ":".join([number] * 3) +
+            " setup=OWNED")
+        require(len(lines) == 2 and re.fullmatch(setup_pattern, lines[0]) is not None
+                and re.fullmatch(pattern, lines[1]) is not None,
+                "Missing/contradictory native owned-fixture cleanup witness; HOLD")
+        witnesses.append({"case": case, "log_sha256": hashlib.sha256(log).hexdigest(),
+                          "setup_witness": lines[0], "cleanup_witness": lines[1], "ctest_exit_code": 0})
+    return {"allowed": True, "scope": "BOTH_NATIVE_CASES_OWN_CLEANUP_WITNESSED", "witnesses": witnesses,
+            "qualification": "Additional disposal gate, not independent XML/native semantic acceptance"}
 
 
