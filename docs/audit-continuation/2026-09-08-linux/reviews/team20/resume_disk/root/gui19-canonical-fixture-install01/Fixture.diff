+// SettingsItem has a clickable Surface around headline/supporting Text. Desktop AX can
+// expose text on a non-actionable child or merge the title and subtitle with ", ".
+// Resolve only the named row's nearest actionable ancestor; never invoke AX actions.
+private fun settingsRow(title: String): (List<MainNavAx>) -> MainNavAx? = { nodes ->
+    val label = unique(nodes.filter { it.name == title || it.name?.startsWith("$title, ") == true })
+    if (label == null) null else {
+        var row: MainNavAx = requireNotNull(label)
+        var depth = 0
+        while (row.actionCount == 0 && row.parent != null) {
+            val parent = requireNotNull(row.parent)
+            assertTrue(++depth <= 48 && parent in 0 until row.index, "SETTINGS_ROW_ANCESTRY")
+            row = nodes[parent]
+        }
+        if (row.actionCount == 0) null else {
+            assertTrue(row.window === label.window && row.enabled && label.enabled, "SETTINGS_ROW_NOT_LIVE")
+            val labelBounds = label.screen
+            val rowBounds = row.screen
+            if (labelBounds == null || rowBounds == null) null else {
+                assertTrue(rowBounds.contains(labelBounds), "SETTINGS_ROW_LABEL_OUTSIDE")
+                // These two production SettingsItem rows have no trailing/nested actions.
+                // Reject an unexpectedly broad ancestor containing a different actionable row.
+                val rowIndex = row.index
+                val nestedAction = nodes.any { candidate ->
+                    if (candidate.index <= rowIndex || candidate.actionCount == 0) false else {
+                        var parent = candidate.parent
+                        var steps = 0
+                        while (parent != null && parent > rowIndex) {
+                            assertTrue(++steps <= 48 && parent < candidate.index, "SETTINGS_ROW_CHILD_ANCESTRY")
+                            parent = nodes[parent].parent
+                        }
+                        parent == rowIndex
+                    }
+                }
+                assertFalse(nestedAction, "SETTINGS_ROW_NESTED_ACTION")
+                row
+            }
+        }
+    }
+}
 private fun named(name: String): (List<MainNavAx>) -> MainNavAx? = { nodes -> unique(nodes.filter { it.name == name }) }
