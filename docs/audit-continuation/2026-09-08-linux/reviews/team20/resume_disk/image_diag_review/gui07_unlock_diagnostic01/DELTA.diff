+    private enum class NativeUnlockStage { INPUT, SUBMIT, RESULT }
+    private enum class NativeUnlockSession { UNINITIALIZED, LOCKED, UNLOCKING, UNLOCKED, LOCKING }
+
+    // Observe Main's existing singleton roots only; input and navigation remain native.
+    // Retain fixed booleans/enums, never model text/password/error content or AX names.
+    @Suppress("TooGenericExceptionCaught")
+    private fun nativeUnlock(timeoutMessage: String) {
+        replaceText("Master password", PASSWORD, readable = false)
+        val (unlock, vault, session) = onEdt {
+            val koin = GlobalContext.get()
+            Triple(koin.get<UnlockViewModel>(), koin.get<VaultViewModel>(),
+                assertNotNull(koin.get<VaultRepository>().getSessionState() as? StateFlow<VaultSessionState>))
+        }
+        var stage = NativeUnlockStage.INPUT
+        var inputAcknowledged = false
+        var diagnostic = "SAMPLE=NONE"
+        fun sample(input: Boolean): Boolean = onEdt {
+            val unlockState = unlock.state.value
+            val vaultState = vault.state.value
+            val sessionPhase = when (session.value) {
+                VaultSessionState.Uninitialized -> NativeUnlockSession.UNINITIALIZED
+                is VaultSessionState.Locked -> NativeUnlockSession.LOCKED
+                VaultSessionState.Unlocking -> NativeUnlockSession.UNLOCKING
+                is VaultSessionState.Unlocked -> NativeUnlockSession.UNLOCKED
+                is VaultSessionState.Locking -> NativeUnlockSession.LOCKING
+            }
+            val passwordMatches = unlockState.password == PASSWORD
+            val nativeCard = credentialCard(snapshot()) != null
+            diagnostic = "SESSION=$sessionPhase PASSWORD_MATCH=$passwordMatches" +
+                " UNLOCK_LOADING=${unlockState.isLoading} UNLOCK_ERROR=${unlockState.errorMessage != null}" +
+                " FAILED_ATTEMPTS=${unlockState.failedAttempts > 0}" +
+                " VAULT_LOADING=${vaultState.isLoading} VAULT_ERROR=${vaultState.errorMessage != null}" +
+                " ROW_LOADED=${vaultState.credentials.any { it.id.value == ID }}" +
+                " ROW_FILTERED=${vaultState.filteredCredentials.any { it.id.value == ID }}" +
+                " AX_CARD=$nativeCard WINDOW_ACTIVE=${frame.isShowing && frame.isActive}"
+            if (input) passwordMatches else nativeCard
+        }
+        try {
+            await("MAIN_NAV_NATIVE_PASSWORD_ACK") { sample(input = true).also { inputAcknowledged = it } }
+            stage = NativeUnlockStage.SUBMIT
+            click(button("Unlock vault")) // The same one native click; no direct event/action or retry.
+            stage = NativeUnlockStage.RESULT
+            await(timeoutMessage, 30) { sample(input = false) } // Original AX success predicate/deadline.
+        } catch (error: Throwable) {
+            runCatching {
+                System.err.println("MAIN_NAV_UNLOCK_DIAGNOSTIC STAGE=$stage INPUT_ACK=$inputAcknowledged $diagnostic")
+            }
+            throw error // Diagnostics do not replace the original assertion or native/input finalizers.
+        }
+    }
