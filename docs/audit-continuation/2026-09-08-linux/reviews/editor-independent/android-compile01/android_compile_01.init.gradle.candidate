import groovy.json.JsonOutput
import org.gradle.api.GradleException
import org.gradle.api.JavaVersion
import org.gradle.api.artifacts.verification.DependencyVerificationMode
import org.gradle.api.tasks.testing.Test
import java.nio.file.*
import java.nio.file.attribute.BasicFileAttributes
import java.security.MessageDigest

// NEW compile-only candidate: NO execution admission. Replace this literal only
// through independent source review: [graph: exactRows, readRoots: [...], offline: boolean].
final Map ADMITTED = null
final String MAIN = ':core:crypto:compileAndroidMain'
final String DEVICE = ':core:crypto:compileAndroidDeviceTest'
final String BASE = 'core/crypto/src/'
final String PKG = 'kotlin/com/passvault/core/crypto/'
def required = [(MAIN): [
    (BASE + 'commonMain/' + PKG + 'LibsodiumCryptoEngine.kt'): '2b8dd21fe476735f16f1ab35543417a70202e7923dfac328f9064e31f5923b57',
    (BASE + 'commonMain/' + PKG + 'RawPasswordHash.kt'): '3fb16abe001752bf44b5a56039c58738ebed0e6ced5972e3ca0985d5a40586eb',
    (BASE + 'androidMain/' + PKG + 'RawPasswordHash.android.kt'): 'd2c4bcd22df2cb89a97e10a4b591d651f224f0b1c5224bc6b5de10f407d0df1c'],
    (DEVICE): [(BASE + 'androidDeviceTest/' + PKG + 'Android32KdfInstrumentation.kt'): 'd9bdb00637773f5d239ffcc5f7d13dc3773e528ef0dec1b1efdffec0ee182310']]
def fail = { String why -> throw new GradleException('AndroidCompile01: ' + why) }
long emitted = 0L
def emit = { Map row ->
    String json = JsonOutput.toJson(row)
    int n = json.getBytes('UTF-8').length
    long ceiling = row.kind == 'finished' ? 8L * 1024 * 1024 : 8L * 1024 * 1024 - 2048
    if (n > 1024 * 1024 || emitted + n > ceiling) fail('receipt budget exceeded')
    emitted += n
    println('PASSVAULT_ANDROID_COMPILE01=' + json)
}
def completed = []
def started = []
String phase = 'init'
def start = gradle.startParameter
def sys = start.systemPropertiesArgs
def props = start.projectProperties
if (gradle.gradleVersion != '9.7.1' || JavaVersion.current() != JavaVersion.VERSION_17 ||
        start.taskNames != [DEVICE] || start.continueOnFailure || !start.excludedTaskNames.empty ||
        start.parallelProjectExecutionEnabled || start.configureOnDemand || start.maxWorkerCount != 1 ||
        start.buildCacheEnabled || start.rerunTasks || start.dependencyVerificationMode != DependencyVerificationMode.STRICT ||
        props['kotlin.compiler.execution.strategy'] != 'in-process' || props['android.builder.sdkDownload'] != 'false' ||
        sys['org.gradle.java.installations.auto-download'] != 'false' || sys['org.gradle.java.installations.auto-detect'] != 'false' ||
        !sys['org.gradle.java.installations.paths'] ||
        new File(sys['org.gradle.java.installations.paths']).canonicalFile != new File(System.getProperty('java.home')).canonicalFile) {
    fail('requires exact selector, Gradle9.7.1/JDK17, serial strict flags and disabled SDK/JDK acquisition')
}
gradle.buildFinished { result ->
    emit([kind: 'finished', phase: phase, completed: completed, failureType: result.failure?.class?.name,
          cases: 0, classpathAttribution: 'NOT_ESTABLISHED', runtimeEvidence: false])
}
gradle.taskGraph.whenReady { graph ->
    phase = 'graph'
    if (graph.allTasks.size() > 64) fail('graph exceeds fixed bound')
    def rows = graph.allTasks.collect { t ->
        [path: t.path, type: t.class.name, enabled: t.enabled,
         dependencies: t.taskDependencies.getDependencies(t).collect { it.path }.sort(),
         finalizers: t.finalizedBy.getDependencies(t).collect { it.path }.sort()]
    }
    emit([kind: 'graph', selector: start.taskNames, tasks: rows])
    if (ADMITTED == null) fail('UNBOUND exact graph/read scope; no task actions admitted')
    if (ADMITTED.keySet() != ['graph', 'readRoots', 'offline'].toSet() || rows != ADMITTED.graph ||
            !(ADMITTED.offline instanceof Boolean) || start.offline != ADMITTED.offline ||
            !(ADMITTED.readRoots instanceof List) || ADMITTED.readRoots.empty || ADMITTED.readRoots.size() > 16) fail('scope binding mismatch')
    if (graph.allTasks.any { t ->
        t instanceof Test || !t.enabled || !t.path.startsWith(':core:crypto:') ||
        t.name ==~ /(?i)(test|connected|managedDevice|device|install|uninstall|sign|validateSigning|package|assemble|publish|upload|download).*/ ||
        (t.name.startsWith('bundle') && t.path != ':core:crypto:bundleAndroidMainClassesToCompileJar')
    }) fail('test/device/install/sign/package/publish/acquisition graph rejected')
    def compilers = [MAIN, DEVICE].collect { name -> graph.allTasks.find { it.path == name } }
    if (compilers.any { it == null }) fail('both real main/device compiler dependencies required')
    def root = gradle.rootProject.projectDir.toPath().toAbsolutePath().normalize()
    def outputBoundary = root.resolve('core/crypto/build')
    def readRoots = ADMITTED.readRoots.collect { new File(it).toPath().toAbsolutePath().normalize() }
    if (!readRoots.contains(root) || readRoots.any { it.nameCount < 2 }) fail('invalid admitted read roots')
    def checked = { File file ->
        def p = file.toPath().toAbsolutePath().normalize()
        if (!readRoots.any { p.startsWith(it) }) fail('input/output escaped admitted roots')
        for (def q = p; q != null; q = q.parent) if (Files.isSymbolicLink(q)) fail('symlink in admitted path')
        p
    }
    long hashed = 0L
    int entries = 0
    def hashFile = { p ->
        def a = Files.readAttributes(p, BasicFileAttributes, LinkOption.NOFOLLOW_LINKS)
        if (!a.isRegularFile() || a.size() > 256L * 1024 * 1024 || (hashed += a.size()) > 2L * 1024 * 1024 * 1024) fail('file/hash budget or type')
        def md = MessageDigest.getInstance('SHA-256')
        byte[] buffer = new byte[65536], header = new byte[8]
        long seen = 0L
        int copied = 0
        Files.newInputStream(p, LinkOption.NOFOLLOW_LINKS).withCloseable { stream ->
            int n
            while ((n = stream.read(buffer)) != -1) {
                if (n == 0) continue
                seen += n
                if (seen > a.size()) fail('input grew while hashing')
                int take = Math.min(n, 8 - copied)
                if (take > 0) { System.arraycopy(buffer, 0, header, copied, take); copied += take }
                md.update(buffer, 0, n)
            }
        }
        def z = Files.readAttributes(p, BasicFileAttributes, LinkOption.NOFOLLOW_LINKS)
        if (seen != a.size() || z.size() != a.size() || z.lastModifiedTime() != a.lastModifiedTime() || z.fileKey() != a.fileKey()) fail('unstable read')
        [path: p.toString(), bytes: seen, sha256: md.digest().encodeHex().toString(),
         classHeader: p.toString().endsWith('.class') ? header.encodeHex().toString() : null]
    }
    def snapshot = { File file, boolean mayBeAbsent ->
        def p = checked(file)
        if (!Files.exists(p, LinkOption.NOFOLLOW_LINKS)) {
            if (!mayBeAbsent) fail('missing declared input')
            return [root: p.toString(), present: false, files: []]
        }
        def found = []
        Files.walk(p).withCloseable { stream ->
            def iterator = stream.iterator()
            while (iterator.hasNext()) {
                def q = checked(iterator.next().toFile())
                if (++entries > 16384) fail('entry budget exceeded')
                if (!Files.isDirectory(q, LinkOption.NOFOLLOW_LINKS)) found.add(hashFile(q))
            }
        }
        [root: p.toString(), present: true, files: found.sort { it.path }]
    }
    def outputs = [:]
    compilers.each { t ->
        def files = t.outputs.files.files.toList()
        if (files.empty || files.size() > 16 || files.any { !checked(it).startsWith(outputBoundary) }) fail('declared output outside fixed build boundary')
        outputs[t.path] = files
        def before = files.collect { snapshot(it, true) }
        emit([kind: 'declared-outputs-before', task: t.path, outputs: before])
        if (before.any { !it.files.empty }) fail('nonempty output before actions; no cleanup/rerun fallback')
        t.doFirst {
            if (outputs[t.path].any { !snapshot(it, true).files.empty }) fail('output became nonempty before compiler')
            def inputs = t.inputs.files.files.toList()
            if (inputs.size() > 4096) fail('declared input-root budget exceeded')
            def receipt = inputs.collect { snapshot(it, false) }
            emit([kind: 'generic-task-inputs', task: t.path, api: 'Task.inputs.files; NOT compiler classpath or visitation', inputs: receipt])
            def inputRows = receipt.collectMany { it.files }
            required[t.path].each { rel, sha ->
                if (!inputRows.any { it.path == root.resolve(rel).toString() && it.sha256 == sha }) fail('required production/harness input not matched: ' + rel)
            }
            started.add(t.path)
            phase = 'compiler-actions'
        }
    }
    graph.afterTask { t, state ->
        if (!(t.path in [MAIN, DEVICE])) return
        emit([kind: 'task-state', task: t.path, executed: state.executed, skipped: state.skipped, upToDate: state.upToDate,
              noSource: state.noSource, skipMessage: state.skipMessage, didWork: state.didWork, failureType: state.failure?.class?.name])
        if (state.failure != null) return
        if (!started.contains(t.path) || !state.executed || state.skipped || state.upToDate || state.noSource || !state.didWork || state.skipMessage != null) fail('no fresh successful compiler action')
        def generated = outputs[t.path].collectMany { snapshot(it, true).files }.unique { it.path }
        String basename = t.path == DEVICE ? 'Android32KdfInstrumentation' : 'LibsodiumCryptoEngine'
        String stem = '/com/passvault/core/crypto/' + basename
        def classes = generated.findAll { it.path.endsWith(stem + '.class') || (it.path.contains(stem + '$') && it.path.endsWith('.class')) }
        if (classes.count { it.path.endsWith(stem + '.class') } != 1 || classes.any { it.classHeader != 'cafebabe0000003d' }) fail('missing/invalid fresh JVM17 base or companion class')
        emit([kind: 'emitted-classes', task: t.path, declaredRoots: outputs[t.path]*.absolutePath, classes: classes,
              generatedFileCount: generated.size(), attribution: 'declared outputs; not APK/DEX/runtime evidence'])
        completed.add(t.path)
        phase = 'compiled-' + completed.size()
    }
}
